# ============================================================
# 环境变量
# ============================================================
APP_NAME=agentic-rag-platform
APP_VERSION=2.0.0
DEBUG=false

# Qdrant
QDRANT_URL=http://localhost:6333

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI API 兼容)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 生成用大模型（回答质量优先）
LLM_MODEL=gpt-4o
# 意图分类用轻量/便宜模型（降本）
INTENT_MODEL=gpt-4o-mini

# Embedding (本地 BGE-M3)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# MinerU（可选，复杂版面 PDF；需先安装 CLI）
MINERU_CMD=mineru
MINERU_TIMEOUT=300

# 认证（生产置 true；api_keys 为 key -> 权限组映射，逗号分隔）
AUTH_ENABLED=false
API_KEYS={"demo":"*","hr":"hr,public"}
